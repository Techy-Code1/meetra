generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id                  String                    @id @default(cuid())
  email                    String                    @unique @db.VarChar(100)
  password_hash            String                    @db.VarChar(255)
  first_name               String?                   @db.VarChar(50)
  last_name                String?                   @db.VarChar(50)
  profile_picture_url      String?                   @db.VarChar(255)
  is_active                Boolean                   @default(true)
  is_verified              Boolean                   @default(false)
  is_deleted               Boolean                   @default(false)
  deleted_at               DateTime?
  created_at               DateTime                  @default(now())
  updated_at               DateTime                  @updatedAt
  auditLogs                AuditLog[]
  authenticationLogs       AuthenticationLog[]
  breakoutRoomParticipants BreakoutRoomParticipant[]
  contactOf                Contact[]                 @relation("ContactUser")
  contacts                 Contact[]                 @relation("UserContacts")
  devices                  Device[]
  emailVerificationTokens  EmailVerificationToken[]
  feedback                 Feedback[]
  files                    File[]
  meetingHosts             MeetingHost[]
  lobbyEntries             MeetingLobby[]
  hostedMeetings           Meeting[]                 @relation("HostedMeetings")
  messages                 Message[]
  notifications            Notification[]
  participants             Participant[]
  passwordResetTokens      PasswordResetToken[]
  refreshTokens            RefreshToken[]
  settings                 Setting[]
  subscriptions            Subscription[]
  userRoles                UserRole[]

  @@map("Users")
}

model Role {
  role_id     String     @id @default(cuid())
  role_name   String     @unique @db.VarChar(50)
  description String?
  userRoles   UserRole[]

  @@map("Roles")
}

model UserRole {
  user_id     String
  role_id     String
  assigned_at DateTime @default(now())
  role        Role     @relation(fields: [role_id], references: [role_id])
  user        User     @relation(fields: [user_id], references: [user_id])

  @@id([user_id, role_id])
  @@map("UserRoles")
}

model RefreshToken {
  token_id    String   @id @default(cuid())
  user_id     String
  token       String   @unique
  device_info String?  @db.VarChar(255)
  ip_address  String?  @db.VarChar(45)
  is_revoked  Boolean  @default(false)
  expires_at  DateTime
  created_at  DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("RefreshTokens")
}

model EmailVerificationToken {
  token_id   String    @id @default(cuid())
  user_id    String
  token      String    @unique @db.VarChar(255)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("EmailVerificationTokens")
}

model PasswordResetToken {
  token_id    String    @id @default(cuid())
  user_id     String
  token       String    @unique @db.VarChar(255)
  expires_at  DateTime
  used_at     DateTime?
  created_at  DateTime  @default(now())
  is_verified Boolean   @default(false)
  user        User      @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("PasswordResetTokens")
}

model AuthenticationLog {
  log_id     String   @id @default(cuid())
  user_id    String
  action     String   @db.VarChar(50)
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.VarChar(255)
  status     String   @default("success") @db.VarChar(20)
  timestamp  DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("AuthenticationLogs")
}

model AuditLog {
  audit_id    String   @id @default(cuid())
  user_id     String
  action      String   @db.VarChar(100)
  entity_type String?  @db.VarChar(50)
  entity_id   String?  @db.VarChar(100)
  details     String?
  timestamp   DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("AuditLogs")
}

model Meeting {
  meeting_id         String              @id @default(cuid())
  host_id            String
  meeting_title      String              @db.VarChar(100)
  description        String?
  meeting_code       String?             @unique @db.VarChar(20)
  meeting_link       String?             @db.VarChar(255)
  status             String              @default("scheduled") @db.VarChar(20)
  is_recorded        Boolean             @default(false)
  max_participants   Int?
  scheduled_at       DateTime
  duration_minutes   Int?
  started_at         DateTime?
  ended_at           DateTime?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  breakoutRooms      BreakoutRoom[]
  feedback           Feedback[]
  files              File[]
  meetingHosts       MeetingHost[]
  meetingInvites     MeetingInvite[]
  lobbyEntries       MeetingLobby[]
  meetingTranscripts MeetingTranscript[]
  host               User                @relation("HostedMeetings", fields: [host_id], references: [user_id])
  messages           Message[]
  participants       Participant[]
  recordings         Recording[]

  @@index([host_id])
  @@index([status])
  @@map("Meetings")
}

model MeetingHost {
  meeting_id String
  host_id    String
  host       User    @relation(fields: [host_id], references: [user_id])
  meeting    Meeting @relation(fields: [meeting_id], references: [meeting_id])

  @@id([meeting_id, host_id])
  @@map("MeetingHosts")
}

model MeetingLobby {
  lobby_id       String    @id @default(cuid())
  meeting_id     String
  participant_id String
  display_name   String?   @db.VarChar(50)
  status         String    @default("waiting") @db.VarChar(20)
  entered_at     DateTime  @default(now())
  admitted_at    DateTime?
  denied_at      DateTime?
  meeting        Meeting   @relation(fields: [meeting_id], references: [meeting_id])
  participant    User      @relation(fields: [participant_id], references: [user_id])

  @@unique([meeting_id, participant_id])
  @@index([meeting_id])
  @@map("MeetingLobbies")
}

model Participant {
  participant_id String    @id @default(cuid())
  meeting_id     String
  user_id        String
  is_muted       Boolean   @default(false)
  is_video_on    Boolean   @default(true)
  is_host        Boolean   @default(false)
  joined_at      DateTime?
  left_at        DateTime?
  meeting        Meeting   @relation(fields: [meeting_id], references: [meeting_id])
  user           User      @relation(fields: [user_id], references: [user_id])

  @@index([meeting_id])
  @@index([user_id])
  @@map("Participants")
}

model MeetingInvite {
  invite_id     String    @id @default(cuid())
  meeting_id    String
  invitee_email String    @db.VarChar(100)
  sent_at       DateTime?
  responded_at  DateTime?
  status        String    @default("pending") @db.VarChar(20)
  meeting       Meeting   @relation(fields: [meeting_id], references: [meeting_id])

  @@index([meeting_id])
  @@map("MeetingInvites")
}

model Message {
  message_id   String    @id @default(cuid())
  meeting_id   String
  sender_id    String
  content      String
  message_type String    @default("text") @db.VarChar(20)
  is_edited    Boolean   @default(false)
  edited_at    DateTime?
  is_deleted   Boolean   @default(false)
  sent_at      DateTime  @default(now())
  meeting      Meeting   @relation(fields: [meeting_id], references: [meeting_id])
  sender       User      @relation(fields: [sender_id], references: [user_id])

  @@index([meeting_id])
  @@map("Messages")
}

model MeetingTranscript {
  transcript_id   String   @id @default(cuid())
  meeting_id      String
  transcript_text String
  language        String?  @db.VarChar(10)
  created_at      DateTime @default(now())
  meeting         Meeting  @relation(fields: [meeting_id], references: [meeting_id])

  @@map("MeetingTranscripts")
}

model BreakoutRoom {
  breakout_id      String                    @id @default(cuid())
  meeting_id       String
  room_name        String?                   @db.VarChar(50)
  max_participants Int?
  status           String                    @default("open") @db.VarChar(20)
  created_at       DateTime                  @default(now())
  participants     BreakoutRoomParticipant[]
  meeting          Meeting                   @relation(fields: [meeting_id], references: [meeting_id])

  @@index([meeting_id])
  @@map("BreakoutRooms")
}

model BreakoutRoomParticipant {
  breakout_id  String
  user_id      String
  joined_at    DateTime?
  left_at      DateTime?
  breakoutRoom BreakoutRoom @relation(fields: [breakout_id], references: [breakout_id])
  user         User         @relation(fields: [user_id], references: [user_id])

  @@id([breakout_id, user_id])
  @@map("BreakoutRoomParticipants")
}

model Recording {
  recording_id     String   @id @default(cuid())
  meeting_id       String
  file_url         String   @db.VarChar(255)
  file_size_mb     Float?
  duration_seconds Int?
  created_at       DateTime @default(now())
  meeting          Meeting  @relation(fields: [meeting_id], references: [meeting_id])

  @@index([meeting_id])
  @@map("Recordings")
}

model File {
  file_id      String   @id @default(cuid())
  user_id      String
  meeting_id   String?
  file_name    String   @db.VarChar(100)
  file_url     String   @db.VarChar(255)
  file_type    String?  @db.VarChar(50)
  file_size_mb Float?
  uploaded_at  DateTime @default(now())
  meeting      Meeting? @relation(fields: [meeting_id], references: [meeting_id])
  user         User     @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("Files")
}

model Subscription {
  subscription_id String    @id @default(cuid())
  user_id         String
  plan_name       String?   @db.VarChar(50)
  price           Decimal?  @db.Decimal(10, 2)
  currency        String    @default("USD") @db.VarChar(10)
  status          String    @default("active") @db.VarChar(20)
  started_at      DateTime?
  expires_at      DateTime?
  payments        Payment[]
  user            User      @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("Subscriptions")
}

model Payment {
  payment_id      String       @id @default(cuid())
  subscription_id String
  amount          Decimal      @db.Decimal(10, 2)
  currency        String       @default("USD") @db.VarChar(10)
  payment_method  String?      @db.VarChar(50)
  status          String       @default("completed") @db.VarChar(20)
  transaction_id  String?      @db.VarChar(100)
  payment_date    DateTime     @default(now())
  subscription    Subscription @relation(fields: [subscription_id], references: [subscription_id])

  @@index([subscription_id])
  @@map("Payments")
}

model Device {
  device_id      String    @id @default(cuid())
  user_id        String
  device_name    String?   @db.VarChar(50)
  device_type    String?   @db.VarChar(50)
  os             String?   @db.VarChar(50)
  browser        String?   @db.VarChar(50)
  is_trusted     Boolean   @default(false)
  last_active_at DateTime?
  user           User      @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("Devices")
}

model Notification {
  notification_id String    @id @default(cuid())
  user_id         String
  type            String?   @db.VarChar(50)
  message         String
  is_read         Boolean   @default(false)
  read_at         DateTime?
  created_at      DateTime  @default(now())
  user            User      @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("Notifications")
}

model Setting {
  setting_id    String   @id @default(cuid())
  user_id       String
  setting_name  String   @db.VarChar(50)
  setting_value String   @db.VarChar(255)
  description   String?
  updated_at    DateTime @updatedAt
  user          User     @relation(fields: [user_id], references: [user_id])

  @@unique([user_id, setting_name])
  @@map("Settings")
}

model Feedback {
  feedback_id  String   @id @default(cuid())
  user_id      String
  meeting_id   String
  rating       Int?
  comments     String?
  is_anonymous Boolean  @default(false)
  submitted_at DateTime @default(now())
  meeting      Meeting  @relation(fields: [meeting_id], references: [meeting_id])
  user         User     @relation(fields: [user_id], references: [user_id])

  @@index([meeting_id])
  @@map("Feedback")
}

model Contact {
  contact_id      String   @id @default(cuid())
  user_id         String
  contact_user_id String
  status          String   @default("pending") @db.VarChar(20)
  added_at        DateTime @default(now())
  contactUser     User     @relation("ContactUser", fields: [contact_user_id], references: [user_id])
  user            User     @relation("UserContacts", fields: [user_id], references: [user_id])

  @@unique([user_id, contact_user_id])
  @@map("Contacts")
}
