generator client {
  provider = "prisma-client-js" 
  previewFeatures = ["driverAdapters"] 
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────

model User {
  user_id             String    @id @default(cuid())
  email               String    @unique @db.VarChar(100)
  password_hash       String    @db.VarChar(255)
  first_name          String?   @db.VarChar(50)
  last_name           String?   @db.VarChar(50)
  profile_picture_url String?   @db.VarChar(255)
  is_active           Boolean   @default(true)
  is_verified         Boolean   @default(false)
  is_deleted          Boolean   @default(false)
  deleted_at          DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // Auth relations
  refreshTokens            RefreshToken[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  authenticationLogs       AuthenticationLog[]
  auditLogs                AuditLog[]

  // App relations
  userRoles                UserRole[]
  hostedMeetings           Meeting[]                 @relation("HostedMeetings")
  meetingHosts             MeetingHost[]
  participants             Participant[]
  messages                 Message[]
  notifications            Notification[]
  devices                  Device[]
  subscriptions            Subscription[]
  settings                 Setting[]
  files                    File[]
  feedback                 Feedback[]
  contacts                 Contact[]                 @relation("UserContacts")
  contactOf                Contact[]                 @relation("ContactUser")
  breakoutRoomParticipants BreakoutRoomParticipant[]

  @@map("Users")
}

model Role {
  role_id     String     @id @default(cuid())
  role_name   String     @unique @db.VarChar(50)
  description String?

  userRoles UserRole[]

  @@map("Roles")
}

model UserRole {
  user_id     String
  role_id     String
  assigned_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id])
  role Role @relation(fields: [role_id], references: [role_id])

  @@id([user_id, role_id])
  @@map("UserRoles")
}

// ─────────────────────────────────────────────
// Token Models (NEW)
// ─────────────────────────────────────────────

model RefreshToken {
  token_id    String    @id @default(cuid())
  user_id     String
  token       String    @unique @db.Text       // hashed token — never store raw
  device_info String?   @db.VarChar(255)       // browser / OS info for sessions page
  ip_address  String?   @db.VarChar(45)
  is_revoked  Boolean   @default(false)        // set true on logout / force-signout
  expires_at  DateTime                         // now + 30 days
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id])                           // fast lookup for "logout all devices"
  @@map("RefreshTokens")
}

model EmailVerificationToken {
  token_id   String    @id @default(cuid())
  user_id    String
  token      String    @unique @db.VarChar(255) // hashed OTP / UUID sent in email
  expires_at DateTime                           // now + 24 hours
  used_at    DateTime?                          // stamped when consumed — prevents reuse
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("EmailVerificationTokens")
}

model PasswordResetToken {
  token_id   String    @id @default(cuid())
  user_id    String
  token      String    @unique @db.VarChar(255) // hashed token sent in reset email
  expires_at DateTime                           // now + 1 hour
  used_at    DateTime?                          // stamped on use — single-use only
  is_verified Boolean   @default(false)
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("PasswordResetTokens")
}

// ─────────────────────────────────────────────
// Auth Logs
// ─────────────────────────────────────────────

model AuthenticationLog {
  log_id     String   @id @default(cuid())
  user_id    String
  action     String   @db.VarChar(50)           // LOGIN | LOGOUT | TOKEN_REFRESH | FAILED
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.VarChar(255)
  status     String   @default("success") @db.VarChar(20) // success | failed
  timestamp  DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("AuthenticationLogs")
}

model AuditLog {
  audit_id    String   @id @default(cuid())
  user_id     String
  action      String   @db.VarChar(100)
  entity_type String?  @db.VarChar(50)          // which model was affected e.g. Meeting
  entity_id   String?  @db.VarChar(100)          // id of the affected record
  details     String?
  timestamp   DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("AuditLogs")
}

// ─────────────────────────────────────────────
// Meetings
// ─────────────────────────────────────────────

model Meeting {
  meeting_id       String    @id @default(cuid())
  host_id          String
  meeting_title    String    @db.VarChar(100)
  description      String?
  meeting_code     String?   @unique @db.VarChar(20)
  meeting_link     String?   @db.VarChar(255)
  status           String    @default("scheduled") @db.VarChar(20) // scheduled | ongoing | ended | cancelled
  is_recorded      Boolean   @default(false)
  max_participants Int?
  scheduled_at     DateTime
  duration_minutes Int?
  started_at       DateTime?
  ended_at         DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  host               User                @relation("HostedMeetings", fields: [host_id], references: [user_id])
  meetingHosts       MeetingHost[]
  participants       Participant[]
  messages           Message[]
  breakoutRooms      BreakoutRoom[]
  recordings         Recording[]
  meetingTranscripts MeetingTranscript[]
  meetingInvites     MeetingInvite[]
  files              File[]
  feedback           Feedback[]

  @@index([host_id])
  @@index([status])
  @@map("Meetings")
}

model MeetingHost {
  meeting_id String
  host_id    String

  meeting Meeting @relation(fields: [meeting_id], references: [meeting_id])
  host    User    @relation(fields: [host_id], references: [user_id])

  @@id([meeting_id, host_id])
  @@map("MeetingHosts")
}

model Participant {
  participant_id String    @id @default(cuid())
  meeting_id     String
  user_id        String
  is_muted       Boolean   @default(false)
  is_video_on    Boolean   @default(true)
  is_host        Boolean   @default(false)
  joined_at      DateTime?
  left_at        DateTime?

  meeting Meeting @relation(fields: [meeting_id], references: [meeting_id])
  user    User    @relation(fields: [user_id], references: [user_id])

  @@index([meeting_id])
  @@index([user_id])
  @@map("Participants")
}

model MeetingInvite {
  invite_id     String    @id @default(cuid())
  meeting_id    String
  invitee_email String    @db.VarChar(100)
  sent_at       DateTime?
  responded_at  DateTime?
  status        String    @default("pending") @db.VarChar(20) // pending | accepted | declined

  meeting Meeting @relation(fields: [meeting_id], references: [meeting_id])

  @@index([meeting_id])
  @@map("MeetingInvites")
}

model Message {
  message_id   String    @id @default(cuid())
  meeting_id   String
  sender_id    String
  content      String
  message_type String    @default("text") @db.VarChar(20) // text | file | emoji | system
  is_edited    Boolean   @default(false)
  edited_at    DateTime?
  is_deleted   Boolean   @default(false)
  sent_at      DateTime  @default(now())

  meeting Meeting @relation(fields: [meeting_id], references: [meeting_id])
  sender  User    @relation(fields: [sender_id], references: [user_id])

  @@index([meeting_id])
  @@map("Messages")
}

model MeetingTranscript {
  transcript_id   String   @id @default(cuid())
  meeting_id      String
  transcript_text String
  language        String?  @db.VarChar(10)
  created_at      DateTime @default(now())

  meeting Meeting @relation(fields: [meeting_id], references: [meeting_id])

  @@map("MeetingTranscripts")
}

// ─────────────────────────────────────────────
// Breakout Rooms
// ─────────────────────────────────────────────

model BreakoutRoom {
  breakout_id      String   @id @default(cuid())
  meeting_id       String
  room_name        String?  @db.VarChar(50)
  max_participants Int?
  status           String   @default("open") @db.VarChar(20) // open | closed
  created_at       DateTime @default(now())

  meeting      Meeting                   @relation(fields: [meeting_id], references: [meeting_id])
  participants BreakoutRoomParticipant[]

  @@index([meeting_id])
  @@map("BreakoutRooms")
}

model BreakoutRoomParticipant {
  breakout_id String
  user_id     String
  joined_at   DateTime?
  left_at     DateTime?

  breakoutRoom BreakoutRoom @relation(fields: [breakout_id], references: [breakout_id])
  user         User         @relation(fields: [user_id], references: [user_id])

  @@id([breakout_id, user_id])
  @@map("BreakoutRoomParticipants")
}

// ─────────────────────────────────────────────
// Recordings & Files
// ─────────────────────────────────────────────

model Recording {
  recording_id     String   @id @default(cuid())
  meeting_id       String
  file_url         String   @db.VarChar(255)
  file_size_mb     Float?
  duration_seconds Int?
  created_at       DateTime @default(now())

  meeting Meeting @relation(fields: [meeting_id], references: [meeting_id])

  @@index([meeting_id])
  @@map("Recordings")
}

model File {
  file_id      String   @id @default(cuid())
  user_id      String
  meeting_id   String?                        // nullable — files can exist outside meetings
  file_name    String   @db.VarChar(100)
  file_url     String   @db.VarChar(255)
  file_type    String?  @db.VarChar(50)       // MIME type e.g. application/pdf
  file_size_mb Float?
  uploaded_at  DateTime @default(now())

  user    User     @relation(fields: [user_id], references: [user_id])
  meeting Meeting? @relation(fields: [meeting_id], references: [meeting_id])

  @@index([user_id])
  @@map("Files")
}

// ─────────────────────────────────────────────
// Subscriptions & Payments
// ─────────────────────────────────────────────

model Subscription {
  subscription_id String    @id @default(cuid())
  user_id         String
  plan_name       String?   @db.VarChar(50)
  price           Decimal?  @db.Decimal(10, 2)
  currency        String    @default("USD") @db.VarChar(10)
  status          String    @default("active") @db.VarChar(20) // active | expired | cancelled
  started_at      DateTime?
  expires_at      DateTime?

  user     User      @relation(fields: [user_id], references: [user_id])
  payments Payment[]

  @@index([user_id])
  @@map("Subscriptions")
}

model Payment {
  payment_id      String   @id @default(cuid())
  subscription_id String
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("USD") @db.VarChar(10)
  payment_method  String?  @db.VarChar(50)      // card | paypal | bank_transfer
  status          String   @default("completed") @db.VarChar(20) // pending | completed | failed | refunded
  transaction_id  String?  @db.VarChar(100)      // gateway reference e.g. Stripe charge_id
  payment_date    DateTime @default(now())

  subscription Subscription @relation(fields: [subscription_id], references: [subscription_id])

  @@index([subscription_id])
  @@map("Payments")
}

// ─────────────────────────────────────────────
// User Extras
// ─────────────────────────────────────────────

model Device {
  device_id      String    @id @default(cuid())
  user_id        String
  device_name    String?   @db.VarChar(50)
  device_type    String?   @db.VarChar(50)
  os             String?   @db.VarChar(50)
  browser        String?   @db.VarChar(50)
  is_trusted     Boolean   @default(false)
  last_active_at DateTime?

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("Devices")
}

model Notification {
  notification_id String    @id @default(cuid())
  user_id         String
  type            String?   @db.VarChar(50)  // meeting_invite | payment | system
  message         String
  is_read         Boolean   @default(false)
  read_at         DateTime?
  created_at      DateTime  @default(now())

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("Notifications")
}

model Setting {
  setting_id    String   @id @default(cuid())
  user_id       String
  setting_name  String   @db.VarChar(50)
  setting_value String   @db.VarChar(255)
  description   String?
  updated_at    DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id])

  @@unique([user_id, setting_name])            // one value per setting key per user
  @@map("Settings")
}

model Feedback {
  feedback_id  String   @id @default(cuid())
  user_id      String
  meeting_id   String
  rating       Int?
  comments     String?
  is_anonymous Boolean  @default(false)
  submitted_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [user_id])
  meeting Meeting @relation(fields: [meeting_id], references: [meeting_id])

  @@index([meeting_id])
  @@map("Feedback")
}

model Contact {
  contact_id      String   @id @default(cuid())
  user_id         String
  contact_user_id String
  status          String   @default("pending") @db.VarChar(20) // pending | accepted | blocked
  added_at        DateTime @default(now())

  user        User @relation("UserContacts", fields: [user_id], references: [user_id])
  contactUser User @relation("ContactUser", fields: [contact_user_id], references: [user_id])

  @@unique([user_id, contact_user_id])         // prevent duplicate contact entries
  @@map("Contacts")
}
